# Public URL of the Bellman API (Render). Exposed to the browser — never put secrets here.
NEXT_PUBLIC_API_URL=https://bellman-api.onrender.com
# Canonical site URL. On Vercel it falls back to VERCEL_PROJECT_PRODUCTION_URL automatically.
NEXT_PUBLIC_SITE_URL=https://seu-dominio.vercel.app

# Bellman Studio (/studio). Somente no servidor: sem NEXT_PUBLIC_, nunca vão para o navegador.
SUPABASE_URL=https://vvxarouexcntkoclljbq.supabase.co
# Chave pública (publishable) do projeto Supabase. Pode ficar em variável comum.
SUPABASE_PUBLISHABLE_KEY=
# Chave SECRETA do Supabase (Project Settings → API Keys → secret). Só para enviar convites.
# Configure direto na Vercel como "Sensitive". Nunca commitar.
SUPABASE_SECRET_KEY=
# Redes Sociais: chave de cifra dos tokens da Meta (32 bytes em base64). A mesma no worker.
# Configure direto na Vercel como "Sensitive". Nunca commitar.
SOCIAL_ENC_KEY=
